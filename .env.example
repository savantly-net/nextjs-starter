# The origin this deployment serves, no trailing slash. Inlined at BUILD time.
# Indexing is allowed only when this equals data/site.json#url, so:
#   production: set it to that URL, or the live site ships "Disallow: /"
#   previews:   leave it unset (or set the preview URL); they stay noindex
NEXT_PUBLIC_SITE_URL=

# Escape hatch: "true" forces indexing on. Don't use it on previews.
# NEXT_PUBLIC_ALLOW_INDEXING=

# Analytics: set on production only. Each tag renders nothing when unset.
# Comma-separated GTM container IDs, e.g. GTM-ABC1234,GTM-XYZ9876
NEXT_PUBLIC_GTM_IDS=
# GA4 loaded directly. Leave unset when a GTM container fires GA4.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# e.g. //cdn.callrail.com/companies/<id>/<key>/12/swap.js
NEXT_PUBLIC_CALLRAIL_SCRIPT_URL=
